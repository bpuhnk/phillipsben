# Enable Plausible by setting this; leave blank to disable analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Docker network attached to your Cloudflare tunnel container
CF_TUNNEL_NETWORK=cloudflare-tunnel
# Used by next-sitemap to generate absolute URLs
SITE_URL=https://phillipsben.com

# ── Career assistant (/ask) ──────────────────────────────────────
# Which backend generates answers: `haiku` (Anthropic — the default) or `local`
# (Switchboard on pop-os). Haiku is the default because it answers in <1s with
# clean instruction-following; the P100 can't prefill the ~11k-token knowledge
# pack within the interactive budget (warm ~10s), so `local` is opt-in for now.
# When set to `local`, it still falls back to Haiku on timeout/error if a key is set.
ASSISTANT_PROVIDER=haiku
# Switchboard chat endpoint, reachable over the tunnel (any path — site reads it
# from here). Only used when ASSISTANT_PROVIDER=local. Leave blank for Haiku-only.
SWITCHBOARD_URL=
# Shared bearer token for Switchboard (it must not be an open relay).
SWITCHBOARD_TOKEN=
# Ollama tag Switchboard should make resident for the local path. mistral-nemo-site
# is the curated build (num_ctx 16384 baked in); must be on Switchboard's SITE_MODELS.
ASSISTANT_MODEL=mistral-nemo-site
# Anthropic key — required for the default Haiku path (and the local fallback).
# Without it, a backend outage shows the friendly "book a call" message.
ANTHROPIC_API_KEY=
