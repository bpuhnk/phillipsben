# Enable Plausible by setting this; leave blank to disable analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Docker network attached to your Cloudflare tunnel container
CF_TUNNEL_NETWORK=cloudflare-tunnel
# Used by next-sitemap to generate absolute URLs
SITE_URL=https://phillipsben.com

# ── Career assistant (/ask) ──────────────────────────────────────
# Which backend generates answers: `local` (Switchboard on pop-os) or `haiku`
# (Anthropic, the fallback). `local` falls back to Haiku automatically when the
# box is down and a key is present.
ASSISTANT_PROVIDER=local
# Switchboard chat endpoint, reachable over the tunnel (any path — site reads it
# from here). Leave blank to force the Haiku path.
SWITCHBOARD_URL=
# Shared bearer token for Switchboard (it must not be an open relay).
SWITCHBOARD_TOKEN=
# Exact Ollama model tag Switchboard should make resident.
ASSISTANT_MODEL=gemma-e4b
# Anthropic key for the Haiku fallback / alt primary. Without it, `local` has no
# safety net and a backend outage shows the friendly "book a call" message.
ANTHROPIC_API_KEY=
